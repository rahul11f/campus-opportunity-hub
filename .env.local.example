# ============================================================
# Campus Opportunity Hub — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ─── Supabase ─────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API

# Your Supabase project URL (safe to expose, NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe to expose, NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your-anon-key

# Supabase service role key — NEVER expose this to the client!
# Used only in server-side API routes for admin operations.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your-service-role-key


# ─── Google Gemini API ────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
# Used for AI extraction of structured data from raw notices.
GEMINI_API_KEY=AIza...your-gemini-api-key


# ─── Upstash Redis (Rate Limiting + Caching) ─────────────────
# Sign up at: https://upstash.com → Create a Redis database
# Used for rate limiting and caching scraped content.
# Leave empty in development (rate limiting will be disabled).
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token


# ─── App Configuration ────────────────────────────────────────
# Your app's public URL (used for OpenGraph, sitemap, canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google AdSense publisher client ID
# Format: ca-pub-XXXXXXXXXXXXXXXXX
# Leave empty in development — ad slots will show placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-your-adsense-id

# Comma-separated list of admin email addresses.
# Only these emails can access /admin/* routes after Supabase auth.
# Leave empty to allow all authenticated users (not recommended for production).
# Example: admin@yourcolleg.edu,tnp@yourcollege.edu
ADMIN_EMAIL_WHITELIST=admin@example.com,tnp@example.com


# ─── Optional / Advanced ──────────────────────────────────────
# Path to Chromium binary for Playwright (self-hosted deployments only)
# On Vercel, Playwright is not needed — Cheerio handles most scraping.
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium

# Node environment (set automatically by Vercel/Next.js)
# NODE_ENV=development
